//@version=5
strategy("Gold Mean Reversion", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.02, process_orders_on_close=true, pyramiding=0)

len = input.int(20, "BB Length")
bmult = input.float(2.0, "BB StdDev Mult")
src = input(close, "Source")
useAtrStop = input.bool(true, "Use ATR Stop")
atrLen = input.int(14, "ATR Length")
atrMult = input.float(2.0, "ATR Stop Mult")
exitAtMid = input.bool(true, "Exit At Midline")
useTrendFilter = input.bool(false, "ADX Trend Filter")
adxLen = input.int(14, "ADX Length")
adxMax = input.float(25.0, "ADX Max (above = strong trend, skip entry)")
dirMode = input.string("Both", "Direction", options=["Both", "Long Only", "Short Only"])

basis = ta.sma(src, len)
dev = bmult * ta.stdev(src, len)
upper = basis + dev
lower = basis - dev

[diplus, diminus, adxVal] = ta.dmi(adxLen, adxLen)
trendOk = useTrendFilter ? adxVal < adxMax : true

longCond = ta.crossunder(src, lower) and trendOk and dirMode != "Short Only"
shortCond = ta.crossover(src, upper) and trendOk and dirMode != "Long Only"

if longCond
    strategy.entry("Long", strategy.long)
if shortCond
    strategy.entry("Short", strategy.short)

atrVal = ta.atr(atrLen)

if exitAtMid
    strategy.exit("XL", "Long", limit=basis, stop=useAtrStop ? strategy.position_avg_price - atrMult * atrVal : na)
    strategy.exit("XS", "Short", limit=basis, stop=useAtrStop ? strategy.position_avg_price + atrMult * atrVal : na)
else
    strategy.exit("XL2", "Long", stop=useAtrStop ? strategy.position_avg_price - atrMult * atrVal : na)
    strategy.exit("XS2", "Short", stop=useAtrStop ? strategy.position_avg_price + atrMult * atrVal : na)

plot(basis, "Mid", color=color.yellow)
plot(upper, "Upper", color=color.red)
plot(lower, "Lower", color=color.green)

posCol = strategy.position_size > 0 ? color.new(#ff3b3b, 0) : strategy.position_size < 0 ? color.new(#4cff00, 0) : color.new(#7a8494, 0)
plot(close, "PosState", color=posCol, linewidth=3)
barcolor(posCol)
